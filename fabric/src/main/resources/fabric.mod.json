{
  "schemaVersion": 1,
  "id": "rysm",
  "version": "${version}",
  "name": "Reimagined YSM",
  "description": "A mod that adds JS scripting support, physics simulation, additional features, and modern performance optimizations to YSM.",
  "authors": [
    "Original: YS Group, TartaricAcid, TomatoPuddin, AryochiL. Modify: EverlaPrismer Aya"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "MIT",
  "icon": "yesstevemodel.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.elfmcys.yesstevemodel.fabric.YesSteveModelFabric"
    ],
    "client": [
      "com.elfmcys.yesstevemodel.fabric.client.YesSteveModelFabricClient"
    ],
    "cardinal-components-entity": [
      "com.elfmcys.yesstevemodel.fabric.YsmComponents"
    ]
  },
  "mixins": [
    "rysm.mixins.json",
    "rysm_fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "yes_steve_model": ">=2.6.0 <2.7.0"
  },
  "suggests": {
    "another-mod": "*"
  },
  "custom": {
    "cardinal-components": [
      "yes_steve_model:star_models",
      "yes_steve_model:auth_models",
      "yes_steve_model:model_info",
      "yes_steve_model:projectile_model",
      "yes_steve_model:vehicle_model"
    ]
  },
  "languageAdapters": {
    "rysm_takeover": "net.everla.ysmCompactLayer.fabric.OfficialYsmLanguageAdapter"
  }
}
