}
void integrate() {
    for(int cursor=traversalStart;cursor<traversalEnd;cursor++) {int i=traversal[cursor];if(bones[i].links.w>=-1 && belongs(i)) {
        if(bones[i].links.w==-1) {nodes[idx(i)].position.xyz=target(i);nodes[idx(i)].velocity.xyz=frameVelocity;}
        vec4 p=bones[i].params;
        int mode=int(bones[i].extra.z);
        float motion=min(1,length(frameVelocity.xz)/2);
        if((mode&2)!=0) nodes[idx(i)].velocity.w=mod(nodes[idx(i)].velocity.w+stepDt*motion*8,6.28318530718);
        for(int end=bones[i].links.y;end>=0;end=bones[end].links.z) {
            vec3 displacement=target(end)-position(end);
            vec3 acceleration=displacement*p.z;
            if((mode&1)==0) acceleration-=vec3(0,p.y,0);
            else acceleration+=displacement*(p.y/max(1.0/16.0,length(displacement)));
            if((mode&2)!=0 && motion>0) {
                float phase=nodes[idx(i)].velocity.w-bones[i].pivot.w*.75;
                acceleration+=normalize(mat3(root)*vec3(1,0,0))*(6*motion*sin(phase))
                        +normalize(mat3(root)*vec3(0,1,0))*(1.5*motion*sin(phase*2));
            }
            vec3 speed=(velocity(end)-frameVelocity)*exp(-p.x*stepDt)+frameVelocity+stepDt*acceleration;
            speed/=1+bones[i].extra.y*length(speed)*stepDt;
            vec3 point=position(end)+stepDt*(speed-frameVelocity);
            if(!finite3(point) || !finite3(speed)) {point=target(end);speed=vec3(0);}
            nodes[idx(end)].position.xyz=point;nodes[idx(end)].velocity.xyz=speed;
        }
    }
    }
}
void constrain() {
    for(int cursor=traversalStart;cursor<traversalEnd;cursor++) {int i=traversal[cursor];
        int parentIndex=bones[i].links.x;
        mat4 parent=parentIndex<0?root:nodes[idx(parentIndex)].actual;
        vec3 e=animRotation(i);
        bool joint=bones[i].links.w>=-1 && belongs(i);
        if(joint) {
            mat4 animated=parent*localMatrix(i,e),inverseParent=inverse(parent);
            vec3 pivot=(animated*vec4(bones[i].pivot.xyz,1)).xyz;
            float reach=0;
            for(int end=bones[i].links.y;end>=0;end=bones[end].links.z) {
                vec3 from=(animated*localMatrix(end,animRotation(end))*vec4(bones[end].pivot.xyz,1)).xyz-pivot;
                reach=max(reach,length(from));
                nodes[idx(end)].source=vec4(mat3(inverseParent)*from,0);
                nodes[idx(end)].desired=vec4(mat3(inverseParent)*(position(end)-pivot),0);
            }
            vec4 previous=rotation(i),correction=limitRotation(fit(i,previous),bones[i].params.w);
            float radius=radiusOf(i,animated);
            bool hasContacts=selectContacts(i,pivot,reach+radius+1e-5);
            sweepMask=contactMask;
            if(compactContacts) for(int k=nextContact(-1);k<colliderCount;k=nextContact(k))
                if(sweepSeparated(i,k,previous,correction,parent,pivot,radius)) sweepMask[k>>5] &= ~(1u<<(k&31));
            float clearance=hasContacts?poseClearance(i,previous,previous,correction,parent,pivot,radius):-1;
            if(clearance>0) {
                vec4 safe=previous,delta=qmul(correction,vec4(-previous.xyz,previous.w));
                float angle=2*atan(length(delta.xyz),abs(delta.w));
                float advance=0,bound=reach*angle;
                // Segment/triangle separation is a lower bound on travel to contact.
                // No point travels farther than reach*angle*interval; advance inside
                // that bound instead of sampling isolated angular poses.
                // Exhausting the work budget stops at the last proven-clear pose.
                for(int attempt=0;attempt<32 && advance<1 && bound>1e-6;attempt++) {
                    if(clearance<=2e-6) break;
                    advance=min(1,advance+clearance*.9/bound);
                    safe=qslerp(previous,correction,advance);
                    if(advance<1) clearance=poseClearance(i,safe,previous,correction,parent,pivot,radius);
                }
                if(advance<1 && bound>1e-6) {correction=safe;nodes[idx(i)].visible.w=1;}
            }
            for(int pass=0;pass<24 && hasContacts;pass++) {
                bool contact=false;
                for(int end=bones[i].links.y;end>=0;end=bones[end].links.z) {
                    vec3 endpoint=pivot+mat3(parent)*qrotate(correction,nodes[idx(end)].source.xyz);
                    vec3 speed=velocity(end)-frameVelocity;
                    for(int k=nextContact(-1);k<colliderCount;k=nextContact(k)) if(accepts(i,k)) {
                        vec3 start=pivot,zero=vec3(0);
                        if(colliders[k].info.y!=0) speed+=frameVelocity;
                        bool hit=resolveSegment(k,start,endpoint,zero,speed,radius,true);contact=hit || contact;
                        if(colliders[k].info.y!=0) speed-=frameVelocity;
                    }
                    nodes[idx(end)].velocity.xyz=speed+frameVelocity;
                    nodes[idx(end)].desired=vec4(mat3(inverseParent)*(endpoint-pivot),0);
                }
                if(!contact) break;
                nodes[idx(i)].visible.w=1;
                correction=limitRotation(fit(i,correction),bones[i].params.w);
            }
            nodes[idx(i)].rotation=correction;
            vec3 candidate=qeuler(normalize(qmul(correction,qzyx(e))));if(finite3(candidate)) e=candidate;
        }
        mat4 actual=parent*localMatrix(i,e);nodes[idx(i)].actual=actual;
        if(joint) {
            nodes[idx(i)].position.xyz=(actual*vec4(bones[i].pivot.xyz,1)).xyz;
            if(bones[i].links.w==-1) nodes[idx(i)].velocity.xyz=frameVelocity;
            for(int end=bones[i].links.y;end>=0;end=bones[end].links.z) {
                vec3 point=(actual*localMatrix(end,animRotation(end))*vec4(bones[end].pivot.xyz,1)).xyz;
                vec3 direction=point-position(i),speed=velocity(end);
                if(dot(direction,direction)>1e-12) {direction=normalize(direction);speed-=dot(speed-velocity(i),direction)*direction;}
                nodes[idx(end)].position.xyz=finite3(point)?point:target(end);nodes[idx(end)].velocity.xyz=speed;
            }
            int first=bones[i].links.y;
            if(treeContacts && first>=0 && bones[first].links.z>=0) {
                // A rigid fork has one angular velocity. Independent endpoint velocities
                // otherwise keep pumping incompatible motion into the branch fit at rest.
                mat3 inertia=mat3(0);vec3 momentum=vec3(0);
                for(int end=first;end>=0;end=bones[end].links.z) {
                    vec3 arm=position(end)-position(i),speed=velocity(end)-velocity(i);
                    inertia+=mat3(dot(arm,arm))-outerProduct(arm,arm);
                    momentum+=cross(arm,speed);
                }
                float regularization=max(1e-9,(inertia[0][0]+inertia[1][1]+inertia[2][2])*1e-7);
                vec3 omega=inverse(inertia+mat3(regularization))*momentum;
                if(finite3(omega)) for(int end=first;end>=0;end=bones[end].links.z)
                    nodes[idx(end)].velocity.xyz=velocity(i)+cross(omega,position(end)-position(i));
            }
        }
    }
}
vec4 displayedContact(int bone,vec4 correction,mat4 parent) {
    if(colliderCount==0) return correction;
    mat4 animated=parent*localMatrix(bone,animRotation(bone)),inverseParent=inverse(parent);
    vec3 pivot=(animated*vec4(bones[bone].pivot.xyz,1)).xyz;
    float reach=0,radius=radiusOf(bone,animated);
    for(int end=bones[bone].links.y;end>=0;end=bones[end].links.z) {
        vec3 from=(animated*localMatrix(end,animRotation(end))*vec4(bones[end].pivot.xyz,1)).xyz-pivot;
        reach=max(reach,length(from));nodes[idx(end)].source=vec4(mat3(inverseParent)*from,0);
    }
    if(!selectContacts(bone,pivot,reach+radius+1e-5)) return correction;
    for(int pass=0;pass<24;pass++) {
        bool contact=false;
        for(int end=bones[bone].links.y;end>=0;end=bones[end].links.z) {
            vec3 endpoint=pivot+mat3(parent)*qrotate(correction,nodes[idx(end)].source.xyz);
            for(int k=nextContact(-1);k<colliderCount;k=nextContact(k)) if(accepts(bone,k)) {
                vec3 start=pivot,zero=vec3(0),speed=vec3(0);
                contact=resolveSegment(k,start,endpoint,zero,speed,radius,true) || contact;
            }
            nodes[idx(end)].desired=vec4(mat3(inverseParent)*(endpoint-pivot),0);
        }
        if(!contact) break;
        correction=limitRotation(fit(bone,correction),bones[bone].params.w);
    }
    return correction;
}
void writeMatrices() {
    // Rebuild even on repeated draws, whose camera pose/light may differ.
    for(int cursor=drawStart;cursor<drawEnd;cursor++) {int i=traversal[cursor];
        int parent=bones[i].links.x;
        vec3 e=animRotation(i);
        if(bones[i].links.w>=-1 && belongs(i)) {
            vec4 previous=nodes[idx(i)].previousRotation, current=rotation(i);
            if(dot(previous,current)<0) current=-current;
            vec4 displayed=normalize(mix(previous,current,renderAlpha));
            // Interpolation between two safe poses need not be safe against a moving
            // terrain plane. Project only the displayed correction; do not feed it
            // back into persistent rotations, positions or velocities.
            displayed=displayedContact(i,displayed,root*(parent<0?mat4(1):nodes[idx(parent)].actual));
            vec3 candidate=qeuler(normalize(qmul(displayed,qzyx(e))));if(finite3(candidate)) e=candidate;
        }
        mat4 local=localMatrix(i,e);
        mat4 actual=(parent<0?mat4(1):nodes[idx(parent)].actual)*local;nodes[idx(i)].actual=actual;
        mat4 transform=renderRoot*actual;
        int outputIndex=offset+bones[i].meta.y;
        mat3 basis=mat3(transform);float det=determinant(basis);
        mat3 normal=abs(det)>1e-15?transpose(inverse(basis)):mat3(0);
        int p=(offset+i)*12;
        bool scaled=animation[p+6]!=0 && animation[p+7]!=0 && animation[p+8]!=0;
        bool ancestor=parent<0 || nodes[idx(parent)].visible.y!=0;
        bool visible=ancestor && scaled && animation[p+9]==0 && bones[i].extra.w==0;
        nodes[idx(i)].visible=ivec4(visible?1:0,ancestor && scaled && animation[p+10]==0?1:0,0,0);
        if(belongs(i) || bones[i].meta.x<0 && tree==0) {
            result[outputIndex].transform=transform;
            result[outputIndex].normal=mat4(normal);
            result[outputIndex].flags=ivec4(bones[i].meta.z!=0?15728880:packedLight,visible?0:1,0,0);
        }
    }
}
void main() {
    int lane=int(gl_GlobalInvocationID.x);
    if(lane>=instanceCount*treeCount) return;
    tree=lane%treeCount;
    offset=(lane/treeCount)*boneCount;
    stateOffset=lane*boneCount;
    traversalStart=traversal[tree*4];traversalEnd=traversal[tree*4+1];
    drawStart=traversal[tree*4+2];drawEnd=traversal[tree*4+3];
    if(matrixOnly!=0) {writeMatrices();return;}
    treeContacts=false;
    for(int cursor=traversalStart;cursor<traversalEnd && !treeContacts;cursor++) {
        int i=traversal[cursor];
        if(belongs(i) && bones[i].links.w>=-1) for(int k=0;k<colliderCount;k++) if(accepts(i,k)) {treeContacts=true;break;}
    }
    bool reset=resetState!=0;
    for(int cursor=traversalStart;cursor<traversalEnd;cursor++) {int i=traversal[cursor];
        int parent=bones[i].links.x;mat4 before=parent<0?root:nodes[idx(parent)].animated;
        mat4 animated=before*localMatrix(i,animRotation(i));nodes[idx(i)].animated=animated;
        vec3 point=(animated*vec4(bones[i].pivot.xyz,1)).xyz;
        nodes[idx(i)].target=vec4(point,0);
        vec3 delta=position(i)-point;
        if(bones[i].links.w==-1 && belongs(i) && dot(delta,delta)>16) reset=true;
    }
    if(reset) for(int cursor=traversalStart;cursor<traversalEnd;cursor++) {int i=traversal[cursor];
        nodes[idx(i)].position.xyz=target(i);nodes[idx(i)].velocity=vec4(0);nodes[idx(i)].rotation=vec4(0,0,0,1);
        nodes[idx(i)].previousRotation=vec4(0,0,0,1);
    }
    if(reset && treeContacts) {
        for(int iteration=0;iteration<8;iteration++) constrain();constrain();
        for(int cursor=traversalStart;cursor<traversalEnd;cursor++) {int i=traversal[cursor];nodes[idx(i)].previousRotation=rotation(i);}
    }
    if(!reset) for(int step=0;step<steps;step++) {
        for(int cursor=traversalStart;cursor<traversalEnd;cursor++) {int i=traversal[cursor];nodes[idx(i)].previousRotation=rotation(i);}
        // Low display cadences must not turn a contact step into a large explicit
        // integration jump. Contact substeps are at most 1/120 second.
        int substeps=treeContacts?clamp(int(ceil(dt*120)),1,120):1;
        stepDt=dt/substeps;
        for(int substep=0;substep<substeps;substep++) {
            // Keep contacts on the rigid pose; free shared-node projection and
            // displacement-derived velocities can sustain contact limit cycles.
            integrate();for(int iteration=0;iteration<8;iteration++) constrain();constrain();
        }
    }
    writeMatrices();
}
